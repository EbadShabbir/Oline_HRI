+def _source_task_renderings(request: str, parts: list[str]) -> set[str]:
+    """Independently rederive permitted additions from the recorded request.
+
+    Do not call the runtime renderer or trust layout/header claims. This is a
+    transformation-integrity check, not an answer-quality or factual judgment.
+    The scoring entry point separately binds this request to the suite prompt.
+    """
+    def negated(text, start):
+        boundary = max(text.rfind(mark, 0, start) for mark in ".!?;\n") + 1
+        return bool(re.search(r"\b(?:do\s+not|don't|never|avoid)\b", text[boundary:start], re.I))
+
+    quotes = tuple(re.finditer(r'"[^"\n]*"|“[^”\n]*”|(?<!\w)\x27[^\x27\n]*\x27(?!\w)', request))
+
+    def directive_match(pattern):
+        return next((match for match in re.finditer(pattern, request, re.I)
+                     if not negated(request, match.start())
+                     and not any(quote.start() <= match.start() < quote.end() for quote in quotes)), None)
+
+    unquoted = re.sub(r'"[^"\n]*"|“[^”\n]*”|(?<!\w)\x27[^\x27\n]*\x27(?!\w)', " ", request)
+    counts = "zero one two three four five six seven eight nine ten eleven twelve".split()
+    numbered = False
+    for numbering in re.finditer(
+        r"\b(\d{1,3}|" + "|".join(counts) + r")[ -]+"
+        r"(?:(?:short|brief|simple|exact|practical|timed)\s+){0,2}numbered\s+(?:steps?|lines?|items?)\b",
+        unquoted, re.I,
+    ):
+        count = int(numbering.group(1)) if numbering.group(1).isdigit() else counts.index(numbering.group(1).lower())
+        boundary = max(unquoted.rfind(mark, 0, numbering.start()) for mark in ".!?;\n") + 1
+        prefix = unquoted[boundary:numbering.start()]
+        qualifier = r"(?:(?:exactly|only|just)\s+)?(?:(?:a|an)\s+)?(?:(?:friendly|polite|formal|informal|brief|short|simple|concise)\s+)?"
+        direct = re.search(r"\b(?:write|give|provide|return|use|include|produce|compose|draft|output|suggest|choose|pick)\s+(?:(?:me|us)\s+)?" + qualifier + r"$", prefix, re.I)
+        formatted = re.search(r"\b(?:in|using|with|as|to)\s+" + qualifier + r"$", prefix, re.I)
+        standalone = re.fullmatch(r"\s*(?:exactly|only)\s+", prefix, re.I)
+        if count == len(parts) and not negated(unquoted, numbering.start()) and (direct or formatted or standalone):
+            numbered = True
+    directive = directive_match(
+        r"\b(?:prefixes|labels|(?:start|begin)\s+(?:(?:the|their)\s+)?(?:lines?|text)\s+with)"
+        r"\s*:?\s*([^.!?\n]+)",
+    )
+    prefixes = []
+    if directive and not negated(request, directive.start()):
+        for match in re.finditer(r"\b([A-Za-z][A-Za-z -]{0,24}):", directive.group(1)):
+            prefixes.append(re.sub(r"^and\s+", "", match.group(1)).strip() + ":")
+    header = directive_match(r"\bheader\s+(?:(?:must\s+be|should\s+be|is)\s+)?[\"'`]?"
+                             r"([A-Za-z_]\w*(?:\s*,\s*[A-Za-z_]\w*)+)")
+    # A header can only be added to an explicitly requested CSV output. It
+    # remains a literal supplied string, never a new data row.
+    csv_output = False
+    for sentence in re.split(r"[.!?\n]", unquoted):
+        for clause in (sentence, *sentence.split(";")[1:]):
+            clause = re.sub(r"^\s*(?:please\s+)?(?:(?:can|could|would|will)\s+you\s+)?", "",
+                            clause, flags=re.I).strip()
+            if re.search(r"\b(?:do\s+not|don't|never|avoid)\b", clause, re.I):
+                continue
+            csv_output |= bool(re.fullmatch(r"(?:only\s+CSV|CSV\s+only)[;,\s]*", clause, re.I)
+                or re.match(r"(?:return|output|emit|produce|provide|give|use)\s+(?:(?:only|plain|valid|raw)\s+)*CSV\b", clause, re.I)
+                or re.match(r"(?:convert|format|render|rewrite|return|output|respond|reply|give|provide)\b.*?\b(?:to|into|as|in)\s+(?:(?:plain|valid|raw)\s+)*CSV\b", clause, re.I))
+    if csv_output:
+        if header and not negated(request, header.start()):
+            literal = ",".join(cell.strip() for cell in header.group(1).split(","))
+            parts = [literal, *parts]
+        return {"\n".join(parts)}
+    if prefixes and len(prefixes) == len(parts):
+        parts = [label + " " + (part[len(label):].lstrip() if part.startswith(label) else part)
