+        singular = re.match(r"(?:(?:the|this|that)\s+" + _ARTIFACT + r"\b|(?:it|that|this)\b)",
+                            target, re.I)
+        supplied = "\n".join([*(message.content for message in history), text[:edit.start("target")]])
+        selected = selected or re.search(
+            r"\b(?:I\s+mean|use|choose|select|pick)\s+(?:the\s+)?"
+            r"(?:first|second|third|fourth|last|\d+(?:st|nd|rd|th))\b", supplied, re.I,
+        )
