+def compose_verified_location(
+    facts: Sequence[AnswerFact], request: str,
+) -> Optional[ComposedAnswer]:
+    """Copy one positively stated location, without volunteering event times.
+
+    The complete subject (including a requested date) must match before a
+    temporal suffix can be omitted. Ambiguous, compound or negative statements
+    retain ordinary guarded generation; this never guesses a location.
+    """
+    parsed = parse_subject_request(request)
+    if (len(facts) != 1 or parsed is None or parsed.mode != "direct"
+            or len(parsed.facets) != 1 or parsed.facets[0].attribute != "location"
+            or not _safe_fact(facts[0].text)
+            or requested_subject_supported(request, facts[0].text) is not True):
+        return None
+    match = re.fullmatch(
+        r"(?P<subject>Your [\w'’ -]{1,160}?) (?P<verb>is|are|was|were) "
+        r"(?P<place>(?:in|at|on|inside|under|above|behind|beside|near) "
+        r"[\w'’ -]{1,160}?)"
+        r"(?: on (?:\d{4}-\d{2}-\d{2}|\d{1,2} [A-Za-z]+ \d{4})"
+        r"(?: at (?:[01]?\d|2[0-3]):[0-5]\d)?)?[.]?",
+        facts[0].text, re.I,
+    )
+    if match is None or re.search(
+        r"\b(?:and|or|but|because|before|after|until|since|when|while|"
+        r"unless|except|provided|whether|once|without|"
+        r"is|are|was|were|will|can|should|must|today|tomorrow|yesterday)\b",
+        match.group("subject")[5:] + " " + match.group("place"), re.I,
+    ):
+        return None
+    query = personal_memory_request(request) or request
+    asks_past = re.search(r"\bwhere\s+(?:was|were)\b", query, re.I) is not None
+    if asks_past != (match.group("verb").casefold() in {"was", "were"}):
+        return None
+    # A dated location must not become an undated current-location claim.
+    # Only remove a date when the request already identifies that event date.
+    if re.search(r"\d{4}-\d{2}-\d{2}|\d{1,2} [A-Za-z]+ \d{4}", facts[0].text):
+        if not parsed.facets[0].dates:
+            return None
+    speech = f"{match.group('subject')} {match.group('verb')} {match.group('place')}."
+    return ComposedAnswer(speech, "verified_location")
 
 
